{
  "name": "aws-examples",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "containerEnv": {
    "AWS_DEFAULT_REGION": "eu-west-2",
    "AWS_CLI_AUTO_PROMPT": "on-partial"
  },
  "postCreateCommand": "curl -s 'https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip' -o /tmp/awscliv2.zip && unzip -q /tmp/awscliv2.zip -d /tmp && sudo /tmp/aws/install --update",
  "secrets": {
    "AWS_ACCESS_KEY_ID": { "description": "AWS access key" },
    "AWS_SECRET_ACCESS_KEY": { "description": "AWS secret key" }
  }
}